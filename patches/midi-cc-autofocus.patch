+    def get_midi_cc_zctrls(self, zmip, midi_chan, cc_num):
+        """Get list of zctrls bound to an external MIDI CC message
+
+        zmip : Index of MIDI input device
+        midi_chan : MIDI channel
+        cc_num : CC number
+        Returns : List of bound zynthian_controller objects from the highest-priority matching binding tier
+        """
+        if zmip is None or zmip < 0 or zmip >= MAX_NUM_MIDI_DEVS:
+            return []
+
+        if zynthian_gui_config.midi_bank_change and cc_num in (0, 32):
+            if 0 <= midi_chan < len(self._midi_chan_2_chain_ids) and self._midi_chan_2_chain_ids[midi_chan]:
+                return []
+
+        key_low = (midi_chan << 8) | cc_num
+
+        # 1. Absolute / Global CC bindings
+        key = (zmip << 16) | key_low
+        if key in self.absolute_midi_cc_binding and self.absolute_midi_cc_binding[key]:
+            return list(self.absolute_midi_cc_binding[key])
+
+        active_chain_id = self.active_chain.chain_id if self.active_chain is not None else None
+        chan_chain_ids = (
+            self._midi_chan_2_chain_ids[midi_chan]
+            if 0 <= midi_chan < len(self._midi_chan_2_chain_ids)
+            else []
+        )
+
+        # 2. Active chain channel-bound CC bindings
+        if active_chain_id is not None:
+            key = (active_chain_id << 16) | key_low
+            if key in self.chain_midi_cc_binding and self.chain_midi_cc_binding[key]:
+                return list(self.chain_midi_cc_binding[key])
+
+        # 3. Other chains' channel-bound CC bindings (prefer chains assigned to midi_chan first)
+        zctrls = []
+        checked_chains = {active_chain_id} if active_chain_id is not None else set()
+        for cid in list(chan_chain_ids) + list(self.chains.keys()):
+            if cid in checked_chains or cid not in self.chains:
+                continue
+            checked_chains.add(cid)
+            key = (cid << 16) | key_low
+            if key in self.chain_midi_cc_binding:
+                for zctrl in self.chain_midi_cc_binding[key]:
+                    if zctrl not in zctrls:
+                        zctrls.append(zctrl)
+        if zctrls:
+            return zctrls
+
+        # 4. Channel-unbound (0xFF) CC bindings (e.g. engine auto-learned CCs)
+        dev_mode = zynautoconnect.get_midi_in_dev_mode(zmip)
+        all_chan_chain_ids = [
+            cid for cid, ch in self.chains.items()
+            if getattr(ch, "midi_chan", None) is not None and ch.midi_chan >= 16
+        ]
+
+        if dev_mode == 0:
+            # MULTI mode: prioritize chains on incoming midi_chan (active chain first if on midi_chan),
+            # then CH#ALL chains, then active chain fallback
+            candidate_groups = []
+            if chan_chain_ids:
+                ordered = [cid for cid in chan_chain_ids if cid == active_chain_id]
+                ordered += [cid for cid in chan_chain_ids if cid != active_chain_id]
+                candidate_groups.append(ordered)
+            if all_chan_chain_ids:
+                ordered = [cid for cid in all_chan_chain_ids if cid == active_chain_id]
+                ordered += [cid for cid in all_chan_chain_ids if cid != active_chain_id]
+                candidate_groups.append(ordered)
+            if active_chain_id is not None:
+                candidate_groups.append([active_chain_id])
+        else:
+            # ACTI mode: prioritize active chain, then chains on incoming midi_chan, then CH#ALL chains
+            candidate_groups = []
+            if active_chain_id is not None:
+                candidate_groups.append([active_chain_id])
+            if chan_chain_ids:
+                candidate_groups.append(list(chan_chain_ids))
+            if all_chan_chain_ids:
+                candidate_groups.append(all_chan_chain_ids)
+
+        key_unbound_low = (0xff << 8) | cc_num
+        checked_chains = set()
+        for group in candidate_groups:
+            group_zctrls = []
+            for cid in group:
+                if cid in checked_chains or cid not in self.chains:
+                    continue
+                checked_chains.add(cid)
+                key = (cid << 16) | key_unbound_low
+                if key in self.chain_midi_cc_binding:
+                    for zctrl in self.chain_midi_cc_binding[key]:
+                        if zctrl not in group_zctrls:
+                            group_zctrls.append(zctrl)
+            if group_zctrls:
+                return group_zctrls
+
+        return []
+
