+    def toggle_midi_cc_autofocus(self):
+        zynthian_gui_config.midi_cc_autofocus = int(not zynthian_gui_config.midi_cc_autofocus)
+        zynconf.save_config({"ZYNTHIAN_UI_MIDI_CC_AUTOFOCUS": str(zynthian_gui_config.midi_cc_autofocus)})
+        logging.info(f"MIDI CC Auto-Focus {'ON' if zynthian_gui_config.midi_cc_autofocus else 'OFF'}")
+
+    def midi_cc_autofocus(self, izmip, chan, num, val=None):
+        """Auto-focus processor and control page for a mapped MIDI CC when Control screen is active"""
+
+        if not self.shown or self.mode != 'control':
+            return
+        if self.zyngui.state_manager.is_busy():
+            return
+        if izmip is None or izmip < 0 or izmip >= self.zyngui.state_manager.get_max_num_midi_devs():
+            return
+
+        # Only trigger when the Control screen is already open
+        cur_screen = self.zyngui.current_screen
+        if self.parent:
+            if cur_screen != "chain_control" or self.parent.subscreen is not self:
+                return
+        elif cur_screen not in ("control", "alsa_mixer", "audio_player", "tempo"):
+            return
+
+        zctrls = self.chain_manager.get_midi_cc_zctrls(izmip, chan, num)
+        if not zctrls:
+            return
+
+        # Already displaying one of the mapped controls on the current encoder page
+        if any(zctrl in self.zcontrollers for zctrl in zctrls):
+            return
+
+        old_active_chain_id = self.chain_manager.active_chain.chain_id if self.chain_manager.active_chain else None
+        abs_key = (izmip << 16) | (chan << 8) | num
+        abs_zctrls = self.chain_manager.absolute_midi_cc_binding.get(abs_key, ())
+
+        for zctrl in zctrls:
+            if self.focus_zctrl(zctrl):
+                # Deliver the initial CC tick when switching chains for a non-active chain binding
+                # (chain_manager.midi_control_change only processes active_chain and absolute bindings)
+                if val is not None and zctrl not in abs_zctrls:
+                    proc = getattr(zctrl, "processor", None)
+                    target_chain_id = getattr(proc, "chain_id", None)
+                    if target_chain_id is not None and target_chain_id != old_active_chain_id:
+                        for z in zctrls:
+                            if z not in abs_zctrls and getattr(getattr(z, "processor", None), "chain_id", None) == target_chain_id:
+                                z.midi_control_change(val)
+                return
+
+    def find_zctrl_page(self, zctrl):
+        """Locate (processor, screen_index, chain_page_index) for a zctrl"""
+
+        proc = getattr(zctrl, "processor", None)
+        if not proc:
+            return None, None, None
+
+        screen_list = proc.get_ctrl_screens()
+        if screen_list:
+            for idx, page_zctrls in enumerate(screen_list.values()):
+                if zctrl in page_zctrls:
+                    return proc, idx, None
+
+        chain = getattr(proc, "chain", None)
+        if chain and zctrl in chain.zctrls:
+            return proc, None, chain.zctrls.index(zctrl) // 4
+
+        return None, None, None
+
+    def find_list_index_for_page(self, proc, screen_index, chain_page_index=None):
+        """Find listbox row index in self.list_data for a processor page or chain controller page"""
+
+        if chain_page_index is not None:
+            for idx, row in enumerate(self.list_data):
+                if len(row) >= 5 and row[1] == -1 and row[4] == chain_page_index:
+                    return idx
+        elif screen_index is not None:
+            for idx, row in enumerate(self.list_data):
+                if len(row) >= 5 and row[1] and row[1] > 0 and row[3] == proc and row[4] == screen_index:
+                    return idx
+        return None
+
+    def focus_zctrl(self, zctrl):
+        """Switch chain/processor and encoder page to display the given zctrl"""
+
+        proc, screen_index, chain_page_index = self.find_zctrl_page(zctrl)
+        if proc is None:
+            return False
+
+        # Special processors (not in a chain): ALSA Mixer, Global Audio Player, Tempo
+        if proc.id < -1:
+            if proc == self.zyngui.state_manager.alsa_mixer_processor:
+                target_screen = "alsa_mixer"
+            elif proc == self.zyngui.state_manager.audio_player:
+                target_screen = "audio_player"
+            elif proc == self.zyngui.state_manager.tempo_processor:
+                target_screen = "tempo"
+            else:
+                return False
+
+            if screen_index is not None:
+                proc.set_current_screen_index(screen_index)
+
+            if self.parent is None and self.zyngui.current_screen == target_screen:
+                target_index = self.find_list_index_for_page(proc, screen_index)
+                if target_index is None:
+                    self.fill_list()
+                    target_index = self.find_list_index_for_page(proc, screen_index)
+                if target_index is not None:
+                    self.select(target_index)
+                    return True
+                return False
+            else:
+                self.zyngui.show_screen(target_screen, hmode=self.zyngui.SCREEN_HMODE_REPLACE)
+                return True
+
+        # Regular chain processor
+        chain_id = proc.chain_id
+        if chain_id is None or chain_id not in self.chain_manager.chains:
+            return False
+
+        target_chain = self.chain_manager.chains[chain_id]
+        target_proc = proc
+        if screen_index is not None:
+            target_proc.set_current_screen_index(screen_index)
+        elif chain_page_index is not None:
+            chain_procs = self.chain_manager.get_processors(chain_id)
+            if not chain_procs:
+                return False
+            target_proc = chain_procs[0]
+            n_chain_pages = (len(target_chain.zctrls) + 3) // 4
+            target_proc.set_current_screen_index(chain_page_index - n_chain_pages - 1)
+        target_chain.set_current_processor(target_proc)
+
+        # Currently inside chain_control
+        if self.parent:
+            active_chain_id = self.chain_manager.active_chain.chain_id if self.chain_manager.active_chain else None
+            if active_chain_id != chain_id:
+                # Clear saved side-chain selection so chain_canvas focuses target_chain.current_processor
+                self.parent.chain_canvas.selected_index = None
+                self.chain_manager.set_active_chain_by_id(chain_id)
+                return True
+            if self.parent.chain_id != chain_id:
+                # Chain switch signal is already queued/in-flight; updated proc & screen_index will be used
+                return True
+
+            # Same chain is already displayed => switch processor & encoder page directly
+            target_index = self.find_list_index_for_page(target_proc, screen_index, chain_page_index)
+            if target_index is None:
+                self.fill_list()
+                target_index = self.find_list_index_for_page(target_proc, screen_index, chain_page_index)
+            if target_index is not None:
+                self.select(target_index)
+                return True
+            return False
+
+        # Currently on standalone control screen (e.g. alsa_mixer / audio_player / tempo) => switch to chain_control
+        self.zyngui.chain_control(chain_id=chain_id, processor=target_proc,
+                                  hmode=self.zyngui.SCREEN_HMODE_REPLACE, reset=True)
+        return True
 
