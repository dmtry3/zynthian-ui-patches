@@ -250,6 +250,138 @@ class zynthian_engine_clippy(zynthian_engine):
             self.set_state_post_note(proc_to, phrase_to + 1)
             proc_to.set_state_flag = False
 
+    def swap_clips(self, proc_a, phrase_a, proc_b, phrase_b):
+        """ Swap two audio clips (or move a clip into an empty cell)
+        Args:
+            proc_a: First clippy processor
+            phrase_a: Phrase index of first clip
+            proc_b: Second clippy processor
+            phrase_b: Phrase index of second clip
+        """
+
+        if proc_a == proc_b and phrase_a == phrase_b:
+            return
+
+        note_a = phrase_a + 1
+        note_b = phrase_b + 1
+
+        state_a = {}
+        state_b = {}
+        for symbol in zctrl_symbols:
+            try:
+                state_a[symbol] = proc_a.controllers_dict[f"{symbol} {note_a}"].value
+            except KeyError:
+                pass
+            try:
+                state_b[symbol] = proc_b.controllers_dict[f"{symbol} {note_b}"].value
+            except KeyError:
+                pass
+
+        def apply_clip_state(proc, phrase, state):
+            note = phrase + 1
+            if not self.set_state_pre_note(proc, note):
+                return
+            proc.set_state_flag = True
+            try:
+                for symbol in zctrl_symbols:
+                    if symbol in state:
+                        try:
+                            proc.controllers_dict[f"{symbol} {note}"].set_value(state[symbol])
+                        except Exception as e:
+                            logging.warning(f"Can't apply clip {symbol} {note}: {e}")
+                self.set_state_post_note(proc, note)
+                if state.get("file") and "gain" in state:
+                    try:
+                        self.libclippy.setGain(proc.midi_chan - 16, phrase, ctypes.c_float(state["gain"]))
+                    except Exception as e:
+                        logging.warning(e)
+            finally:
+                proc.set_state_flag = False
+
+        self.libseq.setPlayState(self.zynseq.scene, phrase_a, proc_a.midi_chan, zynseq.SEQ_STOPPED)
+        self.libseq.setPlayState(self.zynseq.scene, phrase_b, proc_b.midi_chan, zynseq.SEQ_STOPPED)
+
+        apply_clip_state(proc_a, phrase_a, state_b)
+        apply_clip_state(proc_b, phrase_b, state_a)
+
+    def clear_clip(self, proc, phrase):
+        """ Clear / unload an audio clip and reset its controllers to defaults
+        Args:
+            proc: Clippy processor
+            phrase: Phrase index to clear
+        """
+
+        note = phrase + 1
+        if not self.set_state_pre_note(proc, note):
+            return
+
+        self.libseq.setPlayState(self.zynseq.scene, phrase, proc.midi_chan, zynseq.SEQ_STOPPED)
+        defaults = {
+            "file": "",
+            "crop_start": 0,
+            "crop_end": MAX_FRAMES,
+            "zoom": 1,
+            "gain": 0.0,
+            "warp": 1,
+            "beats": 1,
+            "mode": 1,
+            "beat_slice": 1,
+        }
+        proc.set_state_flag = True
+        try:
+            for symbol in zctrl_symbols:
+                if symbol in defaults:
+                    try:
+                        proc.controllers_dict[f"{symbol} {note}"].set_value(defaults[symbol])
+                    except Exception as e:
+                        logging.warning(f"Can't reset clip {symbol} {note}: {e}")
+            self.set_state_post_note(proc, note)
+        finally:
+            proc.set_state_flag = False
+
+    def load_bounced_clip(self, proc, phrase, fpath, beats, name=None):
+        """ Load a bounced WAV file into a Clippy slot with exact beat/crop parameters.
+        Args:
+            proc: Clippy processor
+            phrase: Target phrase index
+            fpath: Full path to the bounced WAV file
+            beats: Exact number of beats in the bounced loop
+            name: Optional display name for the sequence
+        Returns:
+            True on success, False otherwise
+        """
+
+        note = phrase + 1
+        if not fpath or not self.set_state_pre_note(proc, note):
+            return False
+
+        self.libseq.setPlayState(self.zynseq.scene, phrase, proc.midi_chan, zynseq.SEQ_STOPPED)
+        frames = self.libclippy.getFileFrames(bytes(fpath, "utf-8"))
+        beats_val = max(1, min(int(beats), MAX_BEATS))
+        crop_end_val = frames if frames > 0 else MAX_FRAMES
+
+        proc.set_state_flag = True
+        try:
+            proc.controllers_dict[f"file {note}"].set_value(fpath)
+            proc.controllers_dict[f"crop_start {note}"].set_value(0)
+            proc.controllers_dict[f"crop_end {note}"].set_value(crop_end_val)
+            proc.controllers_dict[f"zoom {note}"].set_value(1)
+            proc.controllers_dict[f"gain {note}"].set_value(0.0)
+            proc.controllers_dict[f"warp {note}"].set_value(1)
+            proc.controllers_dict[f"beats {note}"].set_value(beats_val)
+            proc.controllers_dict[f"mode {note}"].set_value(1)
+            proc.controllers_dict[f"beat_slice {note}"].set_value(1)
+            self.set_file(proc, phrase, autoreset=False)
+            if name:
+                self.zynseq.set_sequence_param(self.zynseq.scene, phrase, proc.midi_chan, "name", name)
+                self.libseq.updateSequenceInfo()
+            return True
+        except Exception as e:
+            logging.error(f"Can't load bounced clip {fpath}: {e}")
+            return False
+        finally:
+            proc.set_state_flag = False
+
     # ---------------------------------------------------------------
     # Sample loading, cropping & warping
     # ---------------------------------------------------------------
