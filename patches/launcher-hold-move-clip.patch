+
+        if status == "invalid" or dst is None:
+            if src_pad is not None:
+                src_pad.draw(force=True)
+            self.highlight_launcher()
+            self.set_title_ts = 0
+            err_msg = f"Can't move {src[5]} here" if src[6] else "Can't clear here"
+            self.set_title(err_msg, timeout=1.5)
+            return False
+
+        dst_label = self.get_cell_label(dst)
+        if status == "bounce":
+            if src_pad is not None:
+                src_pad.draw(force=True)
+            self.highlight_launcher()
+            return self.start_bounce_midi_to_clippy(src, dst)
+        if status == "clear":
+            if dst[0] == "PAT":
+                ok = self.clear_pattern_cell(dst)
+            elif dst[0] == "CLP":
+                ok = self.clear_clippy_cell(dst)
+            else:
+                ok = False
+        elif src[0] == "PAT":
+            ok = self.swap_patterns(src, dst)
+        elif src[0] == "CLP":
+            ok = self.swap_clippy_clips(src, dst)
+        else:
+            ok = False
+
+        if ok:
+            self.zynseq.refresh_state()
+            self.refresh_launchers(force=True)
+            self.set_title_ts = 0
+            if status == "clear":
+                self.set_title(f"Cleared {dst_label}", timeout=1.5)
+            elif status == "swap":
+                self.set_title(f"Swapped {src[5]} ↔ {dst_label}", timeout=1.5)
+            else:
+                self.set_title(f"Moved {src[5]} → {dst_label}", timeout=1.5)
+        else:
+            if src_pad is not None:
+                src_pad.draw(force=True)
+            self.highlight_launcher()
+        return ok
+
+    def clear_pattern_cell(self, dst):
+        try:
+            scene = self.zynseq.scene
+            dst_phrase, dst_chan, dst_pat = dst[1], dst[2], dst[3]
+            if self.zynseq.libseq.getPlayState(scene, dst_phrase, dst_chan) != zynseq.SEQ_STOPPED:
+                self.zynseq.libseq.setPlayState(scene, dst_phrase, dst_chan, zynseq.SEQ_STOPPED)
+                self.zynseq.libseq.sendMidiCommand(0xB0 | dst_chan, 123, 0)
+            self.zynseq.libseq.clearPattern(dst_pat)
+            self.zynseq.set_sequence_param(scene, dst_phrase, dst_chan, "name", "")
+            self.zynseq.set_sequence_param(scene, dst_phrase, dst_chan, "repeat", 255)
+            self.zynseq.libseq.updateSequenceInfo()
+            return True
+        except Exception as e:
+            logging.error(f"Can't clear pattern: {e}")
+            return False
+
+    def clear_clippy_cell(self, dst):
+        try:
+            dst_phrase, dst_proc = dst[1], dst[3]
+            self.state_manager.start_busy("clear_clip", "Clearing audio clip...")
+            try:
+                dst_proc.engine.clear_clip(dst_proc, dst_phrase)
+            finally:
+                self.state_manager.end_busy("clear_clip")
+            return True
+        except Exception as e:
+            logging.error(f"Can't clear audio clip: {e}")
+            return False
+
+    def swap_patterns(self, src, dst):
+        try:
+            scene = self.zynseq.scene
+            src_phrase, src_chan, src_pat = src[1], src[2], src[3]
+            dst_phrase, dst_chan, dst_pat = dst[1], dst[2], dst[3]
+
+            # Stop both sequences cleanly before swapping their patterns
+            if self.zynseq.libseq.getPlayState(scene, src_phrase, src_chan) != zynseq.SEQ_STOPPED:
+                self.zynseq.libseq.setPlayState(scene, src_phrase, src_chan, zynseq.SEQ_STOPPED)
+                self.zynseq.libseq.sendMidiCommand(0xB0 | src_chan, 123, 0)
+            if self.zynseq.libseq.getPlayState(scene, dst_phrase, dst_chan) != zynseq.SEQ_STOPPED:
+                self.zynseq.libseq.setPlayState(scene, dst_phrase, dst_chan, zynseq.SEQ_STOPPED)
+                self.zynseq.libseq.sendMidiCommand(0xB0 | dst_chan, 123, 0)
+
+            src_name_raw = self.zynseq.libseq.getSequenceName(scene, src_phrase, src_chan)
+            dst_name_raw = self.zynseq.libseq.getSequenceName(scene, dst_phrase, dst_chan)
+            src_name = src_name_raw.decode("utf-8") if isinstance(src_name_raw, bytes) else (src_name_raw or "")
+            dst_name = dst_name_raw.decode("utf-8") if isinstance(dst_name_raw, bytes) else (dst_name_raw or "")
+            src_repeat = self.zynseq.libseq.getSequenceRepeat(scene, src_phrase, src_chan)
+            dst_repeat = self.zynseq.libseq.getSequenceRepeat(scene, dst_phrase, dst_chan)
+
+            self.zynseq.libseq.removePattern(scene, src_phrase, src_chan, 0, 0)
+            self.zynseq.libseq.removePattern(scene, dst_phrase, dst_chan, 0, 0)
+            self.zynseq.libseq.addPattern(scene, src_phrase, src_chan, 0, 0, dst_pat, True)
+            self.zynseq.libseq.addPattern(scene, dst_phrase, dst_chan, 0, 0, src_pat, True)
+
+            self.zynseq.set_sequence_param(scene, src_phrase, src_chan, "name", dst_name)
+            self.zynseq.set_sequence_param(scene, dst_phrase, dst_chan, "name", src_name)
+            self.zynseq.set_sequence_param(scene, src_phrase, src_chan, "repeat", dst_repeat)
+            self.zynseq.set_sequence_param(scene, dst_phrase, dst_chan, "repeat", src_repeat)
+
+            # Keep clipboard entries aligned with swapped pattern coordinates
+            for idx, item in enumerate(self.clipboard):
+                if item is not None and item[0] == "PAT":
+                    if item[3] == src_pat:
+                        self.clipboard[idx] = ("PAT", dst_phrase, dst_chan, src_pat)
+                    elif item[3] == dst_pat:
+                        self.clipboard[idx] = ("PAT", src_phrase, src_chan, dst_pat)
+
+            self.zynseq.libseq.updateSequenceInfo()
+            return True
+        except Exception as e:
+            logging.error(f"Can't swap patterns: {e}")
+            return False
+
+    def swap_clippy_clips(self, src, dst):
+        try:
+            src_phrase, src_chan, src_proc = src[1], src[2], src[3]
+            dst_phrase, dst_chan, dst_proc = dst[1], dst[2], dst[3]
+            self.state_manager.start_busy("move_clip", "Moving audio clip...")
+            try:
+                src_proc.engine.swap_clips(src_proc, src_phrase, dst_proc, dst_phrase)
+            finally:
+                self.state_manager.end_busy("move_clip")
+
+            # Keep clipboard entries aligned with swapped clip coordinates
+            for idx, item in enumerate(self.clipboard):
+                if item is not None and item[0] == "CLP":
+                    if item[3] == src_proc and item[1] == src_phrase:
+                        self.clipboard[idx] = ("CLP", dst_phrase, dst_chan, dst_proc)
+                    elif item[3] == dst_proc and item[1] == dst_phrase:
+                        self.clipboard[idx] = ("CLP", src_phrase, src_chan, src_proc)
+            return True
+        except Exception as e:
+            logging.error(f"Can't swap audio clips: {e}")
+            return False
+
+    # --------------------------------------------------------------------------
+    # Bounce MIDI pattern -> Clippy audio clip (Hold F4 drag-and-drop)
+    # --------------------------------------------------------------------------
+
+    def _run_on_ui_thread(self, fn):
+        canvas = getattr(self, "right_canvas", None)
+        if canvas is not None and hasattr(canvas, "after"):
+            try:
+                canvas.after(0, fn)
+                return
+            except Exception:
+                pass
+        fn()
+
+    def _get_jack_frame_time(self):
+        jclient = getattr(zynautoconnect, "jclient", None)
+        if jclient is not None:
+            try:
+                return int(jclient.frame_time)
+            except Exception:
+                pass
+        return None
+
+    def _wait_for_jack_capture_connect(self, port_l, rec_proc, timeout=2.0):
+        jclient = getattr(zynautoconnect, "jclient", None)
+        deadline = time.monotonic() + timeout
+        if jclient is None:
+            wait_until = min(deadline, time.monotonic() + 0.25)
+            while time.monotonic() < wait_until:
+                if self._bounce_cancel.is_set() or rec_proc.poll() is not None:
+                    return False
+                sleep(0.01)
+            return rec_proc.poll() is None
+
+        while time.monotonic() < deadline:
+            if self._bounce_cancel.is_set() or rec_proc.poll() is not None:
+                return False
+            try:
+                conns = jclient.get_all_connections(port_l)
+                for conn in conns:
+                    cname = getattr(conn, "name", str(conn))
+                    if "jack_capture" in cname:
+                        return True
+            except Exception:
+                pass
+            sleep(0.005)
+        return rec_proc.poll() is None
+
+    def _trim_bounced_wav(self, raw_wav, final_wav, start_frame, exact_frames, sr):
+        try:
+            import numpy as np
+            import soundfile as sf
+
+            data, file_sr = sf.read(raw_wav, dtype="float32", always_2d=True)
+            total_frames = data.shape[0]
+            channels = data.shape[1]
+            start = max(0, min(int(start_frame), total_frames))
+            end = start + exact_frames
+            if end <= total_frames:
+                trimmed = data[start:end]
+            else:
+                avail = data[start:total_frames]
+                pad = np.zeros((exact_frames - avail.shape[0], channels), dtype=np.float32)
+                trimmed = np.vstack((avail, pad))
+            sf.write(final_wav, trimmed, file_sr or sr, subtype="PCM_24")
+            try:
+                os.remove(raw_wav)
+            except OSError:
+                pass
+            return final_wav
+        except Exception as e:
+            logging.warning(f"Bounce WAV trim fallback ({e}), using raw capture")
+            try:
+                os.replace(raw_wav, final_wav)
+                return final_wav
+            except Exception:
+                return raw_wav
+
+    def cancel_bounce_clip(self):
+        if self._bounce_thread is not None and self._bounce_thread.is_alive():
+            self._bounce_cancel.set()
+            return True
+        return False
+
+    def start_bounce_midi_to_clippy(self, src, dst):
+        if not self.can_bounce_clip(src, dst):
+            return False
+        self._bounce_cancel.clear()
+        self._bouncing_info = (src[4], src[1], dst[4], dst[1])
+        self._bounce_thread = Thread(
+            target=self._bounce_midi_worker,
+            args=(src, dst),
+            name="bounce_midi_clip",
+            daemon=True,
+        )
+        self._bounce_thread.start()
+        return True
+
+    def _bounce_midi_worker(self, src, dst):
+        scene = self.zynseq.scene
+        src_phrase, src_chan, src_pat, src_chain_id, src_label = src[1], src[2], src[3], src[4], src[5]
+        dst_phrase, dst_proc = dst[1], dst[3]
+        dst_label = self.get_cell_label(dst)
+        rec_proc = None
+        raw_wav = None
+        orig_repeat = None
+
+        try:
+            ports = self.get_chain_audio_ports(src_chain_id)
+            if not ports:
+                raise RuntimeError("Source chain has no audio output")
+            port_l, port_r = ports
+
+            n_beats = int(self.zynseq.libseq.getBeatsInPattern(src_pat))
+            if n_beats < 1:
+                raise RuntimeError("Invalid pattern length")
+
+            tempo = float(self.zynseq.libseq.getTempo() or 120.0)
+            if tempo <= 0.0:
+                tempo = 120.0
+            sr = int(zynautoconnect.get_jackd_samplerate() or 48000)
+            expected_sec = n_beats * 60.0 / tempo
+            exact_frames = max(1, int(round(expected_sec * sr)))
+
+            base_fpath = self.state_manager.get_new_capture_fpath("wav")
+            cap_dir = os.path.dirname(base_fpath)
+            if cap_dir:
+                os.makedirs(cap_dir, exist_ok=True)
+            safe_name = re.sub(r"[^A-Za-z0-9_-]+", "_", src_label).strip("_") or "bounce"
+            stem = splitext(basename(base_fpath))[0]
+            bpm_tag = int(round(tempo))
+            final_wav = os.path.join(cap_dir, f"{stem}_{safe_name}_{bpm_tag}bpm.wav")
+            raw_wav = os.path.join(cap_dir, f".{stem}_{safe_name}_raw.wav")
+
+            self.state_manager.start_busy("bounce_clip", f"Bouncing {src_label} → {dst_label}...")
+            self._run_on_ui_thread(lambda: self._set_bounce_title(f"Bouncing {src_label} → {dst_label}..."))
+
+            # Stop source pattern cleanly before bounce
+            if self.zynseq.libseq.getPlayState(scene, src_phrase, src_chan) != zynseq.SEQ_STOPPED:
+                self.zynseq.libseq.setPlayState(scene, src_phrase, src_chan, zynseq.SEQ_STOPPED)
+                self.zynseq.libseq.sendMidiCommand(0xB0 | src_chan, 123, 0)
+                sleep(0.05)
+
+            orig_repeat = self.zynseq.libseq.getSequenceRepeat(scene, src_phrase, src_chan)
+            self.zynseq.libseq.setSequenceRepeat(scene, src_phrase, src_chan, 1)
+
+            cmd = [
+                "/usr/local/bin/jack_capture",
+                "--daemon",
+                "--bitdepth", "24",
+                "--bufsize", "30",
+                "--maxbufsize", "120",
+                "--port", port_l,
+                "--port", port_r,
+                raw_wav,
+            ]
+            rec_proc = Popen(cmd)
+
+            if not self._wait_for_jack_capture_connect(port_l, rec_proc, timeout=2.0):
+                if self._bounce_cancel.is_set():
+                    raise InterruptedError("Bounce cancelled")
+                raise RuntimeError("jack_capture failed to start")
+
+            # Brief pre-roll so jack_capture audio callback is streaming smoothly
+            pre_deadline = time.monotonic() + 0.10
+            while time.monotonic() < pre_deadline:
+                if self._bounce_cancel.is_set():
+                    raise InterruptedError("Bounce cancelled")
+                sleep(0.01)
+
+            f_play = self._get_jack_frame_time()
+            t_play = time.monotonic()
+            self.zynseq.libseq.setPlayState(scene, src_phrase, src_chan, zynseq.SEQ_PLAYING)
+
+            timeout_at = t_play + expected_sec + 2.0
+            while not self._bounce_cancel.is_set():
+                state = self.zynseq.libseq.getPlayState(scene, src_phrase, src_chan)
+                if state == zynseq.SEQ_STOPPED:
+                    break
+                if time.monotonic() >= timeout_at:
+                    break
+                sleep(0.01)
+
+            if self._bounce_cancel.is_set():
+                raise InterruptedError("Bounce cancelled")
+
+            # Allow last JACK audio period to flush into jack_capture
+            sleep(0.05)
+            f_end = self._get_jack_frame_time()
+            t_end = time.monotonic()
+
+            rec_proc.terminate()
+            try:
+                rec_proc.wait(timeout=5.0)
+            except Exception:
+                rec_proc.kill()
+            rec_proc = None
+
+            if not os.path.exists(raw_wav) or os.path.getsize(raw_wav) <= 44:
+                raise RuntimeError("Captured WAV file is empty")
+
+            if f_play is not None and f_end is not None:
+                captured_since_play = (f_end - f_play) & 0xFFFFFFFF
+            else:
+                captured_since_play = int(round((t_end - t_play) * sr))
+
+            try:
+                import soundfile as sf
+                total_frames = sf.info(raw_wav).frames
+            except Exception:
+                total_frames = captured_since_play
+
+            start_frame = max(0, total_frames - captured_since_play)
+            out_wav = self._trim_bounced_wav(raw_wav, final_wav, start_frame, exact_frames, sr)
+
+            ok = dst_proc.engine.load_bounced_clip(dst_proc, dst_phrase, out_wav, n_beats, name=src_label)
+            if not ok:
+                raise RuntimeError("Failed to load bounced clip into Clippy")
+
+            self.state_manager.sync = True
+
+            def on_done():
+                self.zynseq.refresh_state()
+                self.refresh_launchers(force=True)
+                self.set_title_ts = 0
+                self.set_title(f"Bounced {src_label} → {dst_label}", timeout=2.0)
+
+            self._run_on_ui_thread(on_done)
+
+        except InterruptedError:
+            logging.info(f"Bounce cancelled: {src_label} -> {dst_label}")
+            self._run_on_ui_thread(lambda: self._set_bounce_title("Bounce cancelled", timeout=1.5))
+        except Exception as e:
+            logging.error(f"Can't bounce MIDI clip {src_label} -> {dst_label}: {e}")
+            self._run_on_ui_thread(lambda: self._set_bounce_title(f"Bounce failed: {src_label}", timeout=2.0))
+        finally:
+            if rec_proc is not None:
+                try:
+                    rec_proc.terminate()
+                    rec_proc.wait(timeout=2.0)
+                except Exception:
+                    try:
+                        rec_proc.kill()
+                    except Exception:
+                        pass
+            if orig_repeat is not None:
+                try:
+                    self.zynseq.libseq.setSequenceRepeat(scene, src_phrase, src_chan, orig_repeat)
+                except Exception:
+                    pass
+            try:
+                if self.zynseq.libseq.getPlayState(scene, src_phrase, src_chan) != zynseq.SEQ_STOPPED:
+                    self.zynseq.libseq.setPlayState(scene, src_phrase, src_chan, zynseq.SEQ_STOPPED)
+                    self.zynseq.libseq.sendMidiCommand(0xB0 | src_chan, 123, 0)
+            except Exception:
+                pass
+            if raw_wav and os.path.exists(raw_wav):
+                try:
+                    os.remove(raw_wav)
+                except OSError:
+                    pass
+            self._bouncing_info = None
+            self._bounce_thread = None
+            try:
+                self.state_manager.end_busy("bounce_clip")
+            except Exception:
+                pass
+
+    def _set_bounce_title(self, msg, timeout=None):
+        self.set_title_ts = 0
+        if timeout is None:
+            self.set_title(msg)
+        else:
+            self.set_title(msg, timeout=timeout)
+
