+
+            self.zynseq.set_sequence_param(scene, src_phrase, src_chan, "name", dst_name)
+            self.zynseq.set_sequence_param(scene, dst_phrase, dst_chan, "name", src_name)
+            self.zynseq.set_sequence_param(scene, src_phrase, src_chan, "repeat", dst_repeat)
