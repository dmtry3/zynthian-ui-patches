+                self._move_clip_cancelled = True
+            else:
+                self._move_clip_cancelled = False
+                self.zyngui.zynswitch_enable_autolong()
+            if src_pad is not None:
+                src_pad.last_state = None
+                src_pad.draw(force=True)
+            self.set_title_ts = 0
+            self.set_title()
+            self.highlight_launcher()
+            return True
+        if not keep_swallow and self._move_clip_cancelled:
+            self._move_clip_cancelled = False
+            self.zyngui.zynswitch_enable_autolong()
+        return False
+
+    def finish_moving_clip(self):
+        if self.moving_clip is None:
+            return False
+        src = self.moving_clip
+        dst = self.get_active_cell_info()
+        status = self.get_move_clip_target_status()
+        src_pad = self.get_launcher_pad(src[4], src[1])
+        self.moving_clip = None
+        if src_pad is not None:
+            src_pad.last_state = None
+
+        # Restore base title before showing any toast so timeout reverts cleanly
+        self.set_title_ts = 0
+        self.set_title()
+
+        if status in ("same", "noop"):
+            if src_pad is not None:
+                src_pad.draw(force=True)
+            self.highlight_launcher()
