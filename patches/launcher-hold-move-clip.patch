+                    elif item[3] == dst_proc and item[1] == dst_phrase:
+                        self.clipboard[idx] = ("CLP", src_phrase, src_chan, src_proc)
+            return True
+        except Exception as e:
+            logging.error(f"Can't swap audio clips: {e}")
+            return False
