@@ -250,6 +250,60 @@ class zynthian_engine_clippy(zynthian_engine):
             self.set_state_post_note(proc_to, phrase_to + 1)
             proc_to.set_state_flag = False
 
+    def swap_clips(self, proc_a, phrase_a, proc_b, phrase_b):
+        """ Swap two audio clips (or move a clip into an empty cell)
+        Args:
+            proc_a: First clippy processor
+            phrase_a: Phrase index of first clip
+            proc_b: Second clippy processor
+            phrase_b: Phrase index of second clip
+        """
+
+        if proc_a == proc_b and phrase_a == phrase_b:
+            return
+
+        note_a = phrase_a + 1
+        note_b = phrase_b + 1
+
+        state_a = {}
+        state_b = {}
+        for symbol in zctrl_symbols:
+            try:
+                state_a[symbol] = proc_a.controllers_dict[f"{symbol} {note_a}"].value
+            except KeyError:
+                pass
+            try:
+                state_b[symbol] = proc_b.controllers_dict[f"{symbol} {note_b}"].value
+            except KeyError:
+                pass
+
+        def apply_clip_state(proc, phrase, state):
+            note = phrase + 1
+            if not self.set_state_pre_note(proc, note):
+                return
+            proc.set_state_flag = True
+            try:
+                for symbol in zctrl_symbols:
+                    if symbol in state:
+                        try:
+                            proc.controllers_dict[f"{symbol} {note}"].set_value(state[symbol])
+                        except Exception as e:
+                            logging.warning(f"Can't apply clip {symbol} {note}: {e}")
+                self.set_state_post_note(proc, note)
+                if state.get("file") and "gain" in state:
+                    try:
+                        self.libclippy.setGain(proc.midi_chan - 16, phrase, ctypes.c_float(state["gain"]))
+                    except Exception as e:
+                        logging.warning(e)
+            finally:
+                proc.set_state_flag = False
+
+        self.libseq.setPlayState(self.zynseq.scene, phrase_a, proc_a.midi_chan, zynseq.SEQ_STOPPED)
+        self.libseq.setPlayState(self.zynseq.scene, phrase_b, proc_b.midi_chan, zynseq.SEQ_STOPPED)
+
+        apply_clip_state(proc_a, phrase_a, state_b)
+        apply_clip_state(proc_b, phrase_b, state_a)
+
