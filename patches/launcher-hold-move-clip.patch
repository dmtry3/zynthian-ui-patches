+    # --------------------------------------------------------------------------
+    # Hold-button Move / Swap clip functionality (ALT + F4 / S4)
+    # --------------------------------------------------------------------------
+
+    def get_launcher_pad(self, chain_id, phrase):
+        if phrase is None or phrase < 0:
+            return None
+        for strip in self.chain_strips:
+            if strip.chain.chain_id == chain_id:
+                if phrase < len(strip.launchers):
+                    return strip.launchers[phrase]
+                return None
+        return None
+
+    def is_moving_clip_source(self, chain_id, phrase):
+        return self.moving_clip is not None and self.moving_clip[4] == chain_id and self.moving_clip[1] == phrase
+
+    def get_active_cell_info(self, phrase=None):
+        if phrase is None:
+            phrase = self.zynseq.phrase
+        if phrase is None or phrase < 0 or phrase >= self.zynseq.phrases:
+            return None
+        chain = self.chain_manager.get_active_chain()
+        if chain is None:
+            return None
+        if chain.chain_id == 0:
+            return ("PHR", phrase, zynseq.PHRASE_CHANNEL, None, 0)
+        if type(chain.midi_chan) is int and 0 <= chain.midi_chan < 16:
+            pattern = self.zynseq.libseq.getPattern(self.zynseq.scene, phrase, chain.midi_chan, 0, 0)
+            if pattern is None or pattern == 0xFFFFFFFF:
+                return None
+            return ("PAT", phrase, chain.midi_chan, pattern, chain.chain_id)
+        if type(chain.midi_chan) is int and 15 < chain.midi_chan < zynseq.PHRASE_CHANNEL:
+            procs = chain.get_processors()
+            if not procs:
+                return None
+            return ("CLP", phrase, chain.midi_chan, procs[0], chain.chain_id)
+        return None
+
+    def is_cell_occupied(self, cell_info):
+        if cell_info is None:
+            return False
+        kind = cell_info[0]
+        if kind == "PAT":
+            return not self.zynseq.is_pattern_empty(cell_info[3])
+        if kind == "CLP":
+            return bool(cell_info[3].engine.is_clip_busy(cell_info[3], cell_info[1]))
+        if kind == "PHR":
+            return self.zynseq.phrases > 1
+        return False
+
+    def get_cell_label(self, cell_info):
+        if cell_info is None:
+            return ""
+        kind, phrase, chan = cell_info[0], cell_info[1], cell_info[2]
+        if kind == "PHR":
+            return self.get_phrase_title(phrase)
+        try:
+            name = self.zynseq.get_sequence_name(self.zynseq.scene, phrase, chan)
+            if name:
+                return name
+        except:
+            pass
+        return f"{zynseq.CHANNEL_CHARS[chan]}{phrase + 1}"
+
+    def can_start_moving_clip(self):
+        cell = self.get_active_cell_info()
+        if cell is None:
+            return False
+        if cell[0] == "PHR":
+            return self.zynseq.phrases > 1
+        return cell[0] in ("PAT", "CLP")
+
+    def get_chain_audio_ports(self, chain_id):
+        try:
+            chain = self.chain_manager.get_chain(chain_id)
+        except Exception:
+            chain = None
+        if chain is None or not getattr(chain, "zynmixer_proc", None):
+            return None
+        mproc = chain.zynmixer_proc
+        if getattr(mproc, "eng_code", None) == "MI":
+            base = f"zynmixer_chan:output_{mproc.mixer_chan:02d}"
+        else:
+            base = f"zynmixer_bus:output_{mproc.mixer_chan:02d}"
+        return (f"{base}a", f"{base}b")
+
+    def can_bounce_clip(self, src, dst):
+        if src is None or dst is None:
+            return False
+        if src[0] != "PAT" or not src[6] or dst[0] != "CLP":
+            return False
+        if self._bounce_thread is not None and self._bounce_thread.is_alive():
+            return False
+        if self.get_chain_audio_ports(src[4]) is None:
+            return False
+        try:
+            n_beats = int(self.zynseq.libseq.getBeatsInPattern(src[3]))
+        except Exception:
+            n_beats = 0
+        return 1 <= n_beats <= 256
+
+    def get_move_clip_target_status(self, phrase=None):
+        if self.moving_clip is None:
+            return "invalid"
+        dst = self.get_active_cell_info(phrase)
+        if dst is None:
+            return "invalid"
+        if self.moving_clip[0] == "PAT" and dst[0] == "CLP":
+            if self.can_bounce_clip(self.moving_clip, dst):
+                return "bounce"
+            return "invalid"
+        if dst[0] != self.moving_clip[0]:
+            return "invalid"
+        src_occupied = self.moving_clip[6]
+        if dst[0] == "PAT":
+            if dst[1] == self.moving_clip[1] and dst[2] == self.moving_clip[2]:
+                return "same"
+            if dst[3] == self.moving_clip[3]:
+                return "invalid"
+            dst_occupied = self.is_cell_occupied(dst)
+            if src_occupied:
+                return "swap" if dst_occupied else "move"
+            return "clear" if dst_occupied else "noop"
+        if dst[0] == "CLP":
+            if dst[3] == self.moving_clip[3] and dst[1] == self.moving_clip[1]:
+                return "same"
+            dst_occupied = self.is_cell_occupied(dst)
+            if src_occupied:
+                return "swap" if dst_occupied else "move"
+            return "clear" if dst_occupied else "noop"
+        return "invalid"
+
+    def update_moving_clip_title(self, phrase=None):
+        if self.moving_clip is None:
+            return
+        src_label = self.moving_clip[5]
+        src_occupied = self.moving_clip[6]
+        status = self.get_move_clip_target_status(phrase)
+        if src_occupied:
+            if status == "same":
+                msg = f"Move {src_label} → select target"
+            elif status == "move":
+                dst_label = self.get_cell_label(self.get_active_cell_info(phrase))
+                msg = f"Move {src_label} → {dst_label}"
+            elif status == "swap":
+                dst_label = self.get_cell_label(self.get_active_cell_info(phrase))
+                msg = f"Swap {src_label} ↔ {dst_label}"
+            elif status == "bounce":
+                dst_label = self.get_cell_label(self.get_active_cell_info(phrase))
+                try:
+                    n_beats = int(self.zynseq.libseq.getBeatsInPattern(self.moving_clip[3]))
+                except Exception:
+                    n_beats = 0
+                if n_beats > 0:
+                    msg = f"Bounce {src_label} → {dst_label} ({n_beats}♩)"
+                else:
+                    msg = f"Bounce {src_label} → {dst_label}"
+            else:
+                msg = f"Can't move {src_label} here"
+        else:
+            if status in ("same", "noop"):
+                msg = f"Clear ({src_label}) → select clip"
+            elif status == "clear":
+                dst_label = self.get_cell_label(self.get_active_cell_info(phrase))
+                msg = f"Clear {dst_label}"
+            else:
+                msg = "Can't clear here"
+        self.set_title_ts = 0
+        self.set_title(msg)
+
+    def start_moving_clip(self):
+        cell = self.get_active_cell_info()
